QLOO_ENV_FILE=/absolute/path/to/qloo.env
GEMINI_ENV_FILE=/absolute/path/to/free-gemini.env
QLOO_PRIOR_SUCCESS=0
QLOO_SUCCESS_LIMIT=5000
MODEL_CALL_LIMIT=500
# For a public demo: open to anyone, no live Qloo spending, live agent runs capped.
# COUNTERSET_PUBLIC=1
# For a private deployment instead:
# COUNTERSET_ACCESS_TOKEN=choose-a-long-random-workspace-token
# More free Gemini keys, taken in turn so one key's limit does not stop a run:
# GEMINI_FREE_API_KEY_2=
# GEMINI_FREE_API_KEY_3=
# or, on your own machine, paths to files that hold one key each:
# GEMINI_EXTRA_KEY_FILES=
# A paid key, tried only after every free key fails, and only for a live run. Caps: BACKUP_CALLS_PER_VISITOR_HOUR (14),
# BACKUP_CALLS_PER_VISITOR_DAY (28), BACKUP_CALLS_PER_HOUR (40), BACKUP_CALLS_PER_DAY (120), BACKUP_UNTIL (unix time).
# GEMINI_BACKUP_API_KEY=
