QLOO_ENV_FILE=/absolute/path/to/qloo.env
GEMINI_ENV_FILE=/absolute/path/to/free-gemini.env
QLOO_PRIOR_SUCCESS=0
QLOO_SUCCESS_LIMIT=5000
MODEL_CALL_LIMIT=500
# For a public demo: open to anyone, no live Qloo spending, live agent runs capped.
# COUNTERSET_PUBLIC=1
# For a private deployment instead:
# COUNTERSET_ACCESS_TOKEN=choose-a-long-random-workspace-token
